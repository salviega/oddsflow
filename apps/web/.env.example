# NEXT_PUBLIC_ values ship to the browser: use an RPC key restricted to the
# site domain in production.
NEXT_PUBLIC_BASE_RPC_URL=
# Canonical URL for SEO; defaults to https://oddsflow.vercel.app
NEXT_PUBLIC_SITE_URL=
# The demo markets to feature first on the home page, once created on Base
NEXT_PUBLIC_DEMO_MARKET=

# Local fork only (written by scripts/dev-fork.sh)
# NEXT_PUBLIC_FORK=1
# NEXT_PUBLIC_FORK_FROM_BLOCK=
# NEXT_PUBLIC_FORK_MARKET=
