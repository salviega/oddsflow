# OddsFlow — one environment file for the whole monorepo. Copy to `.env` and
# fill in; `.env` is gitignored. Contracts (via pnpm scripts), the web (via
# next.config.ts) and scripts/dev-fork.sh all read it from here.

# ── Contracts ──────────────────────────────────────────────────────────────
# Base mainnet RPC with an API key: fork tests, deploy, demo market, and the
# web server (never sent to the browser; on Vercel, a sensitive variable).
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Only for `pnpm deploy:base` (contract verification on Basescan).
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
# Question of the market `pnpm demo:market` creates (optional).
DEMO_MARKET_NAME="Will OddsFlow win a prize at ETHGlobal Tokyo 2026?"

# ── Deployer ───────────────────────────────────────────────────────────────
# The account that deploys OddsFlow and creates the demo markets on Base.
# Keep only what deploying costs in it: the key below controls its funds.
DEPLOYER_ADDRESS=0xYOUR_DEPLOYER_ADDRESS
DEPLOYER_PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY

# ── Web ────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ values ship to the browser: in production use an RPC key
# restricted to the site's domain.
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Canonical URL for SEO; defaults to https://oddsflow.vercel.app
NEXT_PUBLIC_SITE_URL=https://oddsflow.vercel.app
# Demo market to feature first on the home page, once created on Base.
NEXT_PUBLIC_DEMO_MARKET=0xYOUR_DEMO_MARKET_ADDRESS

# Local fork only: scripts/dev-fork.sh writes these to `.env.local`, which
# takes precedence over this file. Delete `.env.local` to point at Base.
# NEXT_PUBLIC_FORK=1
# NEXT_PUBLIC_FORK_FROM_BLOCK=
# NEXT_PUBLIC_FORK_MARKET=
